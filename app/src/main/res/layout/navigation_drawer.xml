<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/drawer_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <include layout="@layout/activity_main" />

    <com.google.android.material.navigation.NavigationView
        android:id="@id/navigation_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@color/white">

            <FrameLayout
                android:id="@id/fr1"
                android:layout_width="fill_parent"
                android:layout_height="160.0dip">

                <ImageView
                    android:id="@id/imgNavigationView"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:fontFamily="@font/main"
                    android:gravity="center"
                    android:text="Text Photo"
                    android:textColor="@color/white"
                    android:textSize="80.0dip" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_below="@id/fr1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@id/ll_gmail"
                    android:layout_width="fill_parent"
                    android:layout_height="56.0dip"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8.0dip"
                        android:src="@drawable/ic_gmail" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:fontFamily="@font/san_regular"
                        android:gravity="center_vertical"
                        android:paddingLeft="8.0dip"
                        android:text="@string/email_feedback"
                        android:textColor="@color/black"
                        android:textSize="18.0dip" />
                </LinearLayout>

                <LinearLayout
                    android:id="@id/ll_rate"
                    android:layout_width="fill_parent"
                    android:layout_height="56.0dip"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8.0dip"
                        android:src="@drawable/ic_star_light" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:fontFamily="@font/san_regular"
                        android:gravity="center_vertical"
                        android:paddingLeft="8.0dip"
                        android:text="@string/rate_5_stars"
                        android:textColor="@color/black"
                        android:textSize="18.0dip" />
                </LinearLayout>

                <LinearLayout
                    android:id="@id/ll_Share"
                    android:layout_width="fill_parent"
                    android:layout_height="56.0dip"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="24.0dip"
                        android:layout_margin="8.0dip"
                        android:src="@drawable/ic_share2" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:fontFamily="@font/san_regular"
                        android:gravity="center_vertical"
                        android:paddingLeft="8.0dip"
                        android:text="@string/share"
                        android:textColor="@color/black"
                        android:textSize="18.0dip" />
                </LinearLayout>

                <LinearLayout
                    android:id="@id/ll_Policy"
                    android:layout_width="fill_parent"
                    android:layout_height="56.0dip"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:layout_margin="8.0dip"
                        android:src="@drawable/ic_privacy_policy" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:fontFamily="@font/san_regular"
                        android:gravity="center_vertical"
                        android:paddingLeft="8.0dip"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/black"
                        android:textSize="18.0dip" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8.0dip"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@id/admob_banner"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>