<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <include
            android:id="@+id/lay_actionbar"
            layout="@layout/include_actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/twenty" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/lay_actionbar">

            <ScrollView
                android:id="@+id/scrollView2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentBottom="true"
                    android:background="#ffffff"
                    android:foregroundGravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.64">

                    <ImageView
                        android:layout_width="170dp"
                        android:layout_height="55dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="25dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/logowhite"
                        android:backgroundTint="@color/them_color"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:tint="@color/them_color" />


                    <EditText
                        android:id="@+id/edt_oldpass"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20.0dip"
                        android:layout_marginTop="9dp"
                        android:layout_marginRight="20.0dip"
                        android:background="#ffffff"
                        android:drawableLeft="@drawable/ic_baseline_lock_24"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/colorPrimary"
                        android:elevation="1dp"
                        android:hint="Existing Password"
                        android:inputType="textPassword"
                        android:paddingLeft="10dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:singleLine="true"
                        android:textColor="@color/c_black"
                        android:textColorHighlight="@color/white"
                        android:textColorHint="@color/c_gray2"
                        android:textSize="@dimen/ts_seventeen" />

                    <EditText
                        android:id="@+id/edt_newpass"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20.0dip"
                        android:layout_marginTop="9dp"
                        android:layout_marginRight="20.0dip"
                        android:background="#ffffff"
                        android:drawableLeft="@drawable/ic_baseline_lock_24"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/colorPrimary"
                        android:elevation="1dp"
                        android:hint="New Password"
                        android:inputType="textPassword"
                        android:paddingLeft="10dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:singleLine="true"
                        android:textColor="@color/c_black"
                        android:textColorHighlight="@color/white"
                        android:textColorHint="@color/c_gray2"
                        android:textSize="@dimen/ts_seventeen" />

                    <EditText
                        android:id="@+id/edt_newpass_again"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20.0dip"
                        android:layout_marginTop="9dp"
                        android:layout_marginRight="20.0dip"
                        android:background="#ffffff"
                        android:drawableLeft="@drawable/ic_baseline_lock_24"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/colorPrimary"
                        android:elevation="1dp"
                        android:hint="confirm password"
                        android:inputType="textPassword"
                        android:paddingLeft="10dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:singleLine="true"
                        android:textColor="@color/c_black"
                        android:textColorHighlight="@color/white"
                        android:textColorHint="@color/c_gray2"
                        android:textSize="@dimen/ts_seventeen" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="25dp"
                        android:layout_marginEnd="25dp"
                        android:background="@color/c_gray2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="25dp"
                        android:layout_marginBottom="3.0dip"
                        android:foregroundGravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">


                        <androidx.appcompat.widget.AppCompatButton
                            style="@style/buttonstyle"
                            android:id="@+id/btn_update"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginEnd="4dp"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:text="Update Password"
                            android:textColor="#ffffffff" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </RelativeLayout>

        <include
            layout="@layout/include_connection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/twenty" />

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>