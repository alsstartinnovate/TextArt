<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/headlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/lay_actionbar"
            layout="@layout/include_actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:padding="@dimen/twenty" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/lay_actionbar"
            android:background="@color/appbackcolor">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/ten"
                android:layout_marginRight="@dimen/ten">

                <RelativeLayout
                    android:id="@+id/lay_form"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <RelativeLayout
                        android:id="@+id/card_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/layphone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lay_logoname"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/ten"
                            android:orientation="vertical"
                            android:padding="@dimen/five"
                            android:src="@drawable/logo">

                            <TextView
                                android:id="@+id/txt_username"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_head_one"
                                android:textSize="@dimen/ts_twentyfive" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/edittext_height"
                                    android:layout_marginTop="@dimen/seven"
                                    android:background="@drawable/back_edittext_noborder_light"
                                    android:text="+91- "
                                    android:textSize="@dimen/ts_thirtyfive"
                                    android:visibility="gone" />

                                <com.rilixtech.widget.countrycodepicker.CountryCodePicker
                                    android:id="@+id/addon_countrycode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/edittext_height"
                                    android:layout_marginTop="@dimen/seven"
                                    android:gravity="center_vertical"
                                    app:ccp_countryPreference="IN"
                                    app:ccp_hideNameCode="true"
                                    app:ccp_hidePhoneCode="false"
                                    app:ccp_setCountryByTimeZone="true"
                                    app:ccp_showFlag="true"
                                    app:ccp_textColor="@color/black"
                                    app:ccp_textSize="@dimen/ts_fifteen" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/ed_phone"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/edittext_height"
                                        android:layout_marginTop="@dimen/seven"
                                        android:background="@drawable/back_edittext_noborder_light"
                                        android:inputType="phone"
                                        android:textColorHint="@color/black"
                                        android:textSize="@dimen/ts_thirtyfive" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/theme_bluegradient_one" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/termscondition"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/fifteen"
                                android:text="@string/register_terms"
                                android:textSize="@dimen/ts_fifteen" />
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/card_phone"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/layotp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lay_logoname"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/ten"
                            android:orientation="vertical"
                            android:padding="@dimen/five"
                            android:src="@drawable/logo">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_otp"
                                android:textSize="@dimen/ts_twentyfive" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/ed_otp"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/edittext_height"
                                        android:layout_marginTop="@dimen/seven"
                                        android:background="@drawable/back_edittext_noborder_light"
                                        android:inputType="numberPassword"
                                        android:textSize="@dimen/ts_thirtyfive" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/theme_bluegradient_one" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/card_otp"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/layname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lay_logoname"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/ten"
                            android:orientation="vertical"
                            android:padding="@dimen/five"
                            android:src="@drawable/logo">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_entername"
                                android:textSize="@dimen/ts_twentyfive" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/ed_name"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/edittext_height"
                                        android:layout_marginTop="@dimen/seven"
                                        android:background="@drawable/back_edittext_noborder_light"
                                        android:inputType="text"
                                        android:textSize="@dimen/ts_thirtyfive" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/theme_bluegradient_one" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/card_name"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/layemail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lay_logoname"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/ten"
                            android:orientation="vertical"
                            android:padding="@dimen/five"
                            android:src="@drawable/logo">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_enteremail"
                                android:textSize="@dimen/ts_twentyfive" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/ed_email"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/edittext_height"
                                        android:layout_marginTop="@dimen/seven"
                                        android:background="@drawable/back_edittext_noborder_light"
                                        android:inputType="textEmailAddress"
                                        android:textSize="@dimen/ts_twentyfive" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/theme_bluegradient_one" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/card_email"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/laypwd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lay_logoname"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/ten"
                            android:orientation="vertical"
                            android:padding="@dimen/five"
                            android:src="@drawable/logo">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_enterpassword"
                                android:textSize="@dimen/ts_twentyfive" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/ed_password"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/edittext_height"
                                        android:layout_marginTop="@dimen/seven"
                                        android:background="@drawable/back_edittext_noborder_light"
                                        android:inputType="textPassword"
                                        android:textSize="@dimen/ts_thirtyfive" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/theme_bluegradient_one" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/card_password"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:layout_marginBottom="@dimen/ten"
                            android:orientation="vertical"
                            android:padding="@dimen/five">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_selectgender"
                                android:textSize="@dimen/ts_twentyfive" />

                            <RadioGroup
                                android:id="@+id/radio_gender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/five"
                                android:orientation="vertical">

                                <RadioButton
                                    android:id="@+id/radio_male"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/five"
                                    android:layout_marginTop="@dimen/five"
                                    android:checked="true"
                                    android:text="Male"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                                    android:textColor="@color/fontcolortextview"
                                    android:textSize="@dimen/ts_twentyfive" />

                                <RadioButton
                                    android:id="@+id/radio_female"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/five"
                                    android:layout_marginTop="@dimen/five"
                                    android:text="Female"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                                    android:textColor="@color/fontcolortextview"
                                    android:textSize="@dimen/ts_twentyfive" />

                                <RadioButton
                                    android:id="@+id/radio_transgender"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/five"
                                    android:layout_marginTop="@dimen/five"
                                    android:text="Transgender"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                                    android:textColor="@color/fontcolortextview"
                                    android:textSize="@dimen/ts_twentyfive" />
                            </RadioGroup>
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_dob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/card_gender"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:layout_marginBottom="@dimen/ten"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_marginBottom="@dimen/ten"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/fortyfive"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="@dimen/five"
                                    android:paddingRight="@dimen/five"
                                    android:text="Date of Birth"
                                    android:textColor="@color/fontcolortextview"
                                    android:textSize="@dimen/ts_twentyfive" />

                                <TextView
                                    android:id="@+id/txt_dob"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/fortyfive"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="@dimen/five"
                                    android:paddingRight="@dimen/five"
                                    android:text="@string/register_selectdob"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/ts_fifteen" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txt_setdob"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/fortyfive"
                                android:gravity="center_vertical"
                                android:paddingLeft="@dimen/five"
                                android:paddingRight="@dimen/five"
                                android:textColor="@color/fontcolortextview"
                                android:textSize="@dimen/ts_twenty" />
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/card_email"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/layusername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lay_logoname"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/ten"
                            android:orientation="vertical"
                            android:padding="@dimen/five"
                            android:src="@drawable/logo">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_enterusername"
                                android:textSize="@dimen/ts_twentyfive" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/ed_username"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/edittext_height"
                                        android:layout_marginTop="@dimen/seven"
                                        android:background="@drawable/back_edittext_noborder_light"
                                        android:inputType="text"
                                        android:textSize="@dimen/ts_thirtyfive" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/theme_bluegradient_one" />

                                    <TextView
                                        android:id="@+id/txt_usernameavailability"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/three"
                                        android:text="isusernameavailable"
                                        android:textSize="@dimen/ts_fifteen" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lay_form"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btn_backform"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/fortyfive"
                        android:layout_marginTop="@dimen/fortyfive"
                        android:layout_marginRight="@dimen/five"
                        android:layout_weight="1"
                        android:background="@drawable/back_button_dark"
                        android:text="Back"
                        android:textColor="@color/fontcolorbutton"
                        android:textSize="@dimen/ts_twenty" />

                    <Button
                        android:id="@+id/btn_finish"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/fortyfive"
                        android:layout_marginLeft="@dimen/five"
                        android:layout_marginTop="@dimen/fortyfive"
                        android:layout_weight="1"
                        android:background="@drawable/back_button_dark"
                        android:text="Next"
                        android:textColor="@color/fontcolorbutton"
                        android:textSize="@dimen/ts_twenty" />
                </LinearLayout>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            layout="@layout/include_connection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/twenty" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>