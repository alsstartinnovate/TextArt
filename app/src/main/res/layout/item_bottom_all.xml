<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardview"
    android:layout_width="wrap_content"
    android:layout_marginLeft="@dimen/seven"
    android:layout_marginTop="@dimen/three"
    android:layout_marginBottom="@dimen/three"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/fifty"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgdrawable"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/thirtyfive"
            android:layout_gravity="center"
            android:backgroundTint="@color/blue"
            android:foregroundGravity="center"
            android:padding="@dimen/five"
            android:src="@drawable/prepaid" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:foregroundGravity="center"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/c_gray2"
            android:textSize="@dimen/ts_fifteen" />
    </LinearLayout>
</LinearLayout>



