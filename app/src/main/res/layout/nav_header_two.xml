<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="@drawable/side_nav_bar"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <com.mikhaellopez.circularimageview.CircularImageView
        android:id="@+id/menuheader_dp"
        android:layout_width="@dimen/seventy"
        android:layout_height="@dimen/seventy"
        android:paddingTop="@dimen/nav_header_vertical_spacing"
        app:srcCompat="@drawable/logowhite" />

    <TextView
        android:id="@+id/menuheader_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/eight"
        android:text="User name"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/menuheader_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/three"
        android:text="User email"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/menuheader_memberid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/three"
        android:text="User memberid"
        android:textColor="@color/white" />

</LinearLayout>
