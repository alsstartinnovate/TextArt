<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lay_settingfive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:visibility="gone">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <RelativeLayout
            android:id="@+id/lay_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/lay_head_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirtyfive"
                android:layout_above="@+id/lay_color_picker"
                android:layout_toStartOf="@+id/lay_btn_bottom"
                android:background="#f2f2f2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="left"
                    android:padding="@dimen/five"
                    android:text="Change below setting and apply"
                    android:textColor="@color/black"
                    android:textSize="@dimen/ts_fifteen"
                    android:visibility="visible" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/simpleSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/fifteen"
                    android:checked="false" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/lay_color_picker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirtyfive"
                android:layout_above="@+id/lay_btn_head"
                android:layout_toStartOf="@+id/lay_btn_bottom"
                android:background="#f2f2f2"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_picker_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:scrollbars="vertical"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_color_picker" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/lay_btn_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_toStartOf="@+id/lay_btn_bottom"
                android:background="#f2f2f2"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/lay_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="invisible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/five">

                        <TextView
                            android:id="@+id/txt_settingname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="@dimen/five"
                            android:text="brightness : "
                            android:textColor="@color/black"
                            android:textSize="@dimen/ts_forteen"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/txt_settingvalue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="@dimen/five"
                            android:text="23"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ts_forteen"
                            android:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/seekbar_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/five"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/five">

                        <TextView
                            android:id="@+id/txt_settingname_two"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="@dimen/five"
                            android:text="brightness : "
                            android:textColor="@color/white"
                            android:textSize="@dimen/ts_forteen"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/txt_settingvalue_two"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="@dimen/five"
                            android:text="23"
                            android:textColor="@color/white"
                            android:textSize="@dimen/ts_forteen"
                            android:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/seekbar_lay_two"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/five"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lay_btn_bottom"
                android:layout_width="@dimen/forty"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignTop="@+id/lay_head_text"
                android:layout_alignParentBottom="true"
                android:background="@color/colorPrimary"
                android:orientation="vertical"
                android:paddingTop="@dimen/ten"
                android:paddingBottom="@dimen/ten"
                android:paddingLeft="@dimen/five"
                android:paddingRight="@dimen/five"
                android:weightSum="4"
                android:visibility="visible">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/dialog_apply"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/forty"
                    android:layout_marginLeft="@dimen/two"
                    android:layout_weight="1"
                    android:background="@drawable/icon" />

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/fifty"
                    android:layout_marginLeft="@dimen/two"
                    android:layout_weight="2"
                    android:background="@color/transparent" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/dialog_close"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/forty"
                    android:layout_marginRight="@dimen/two"
                    android:layout_weight="1"
                    android:background="@drawable/icon_delete" />

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>
</RelativeLayout>