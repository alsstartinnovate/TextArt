<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/headlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appbackcolor">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/lay_actionbar"
            layout="@layout/include_actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/twenty" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/lay_actionbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                tools:context="com.ksstartup.appname.ActivityForgotPassword">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/threehundred"
                        android:src="@drawable/ic_verification"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.4"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:ignore="MissingConstraints"
                        tools:layout_editor_absoluteY="-2dp" />

                    <LinearLayout
                        android:id="@+id/llay_forget_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/thirty"
                            android:text="Enter otp send to your mobile"
                            android:textSize="@dimen/ts_twentyfive" />

                        <LinearLayout
                            android:id="@+id/layphone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/thirtyfive"
                            android:layout_marginTop="@dimen/twenty"
                            android:layout_marginRight="@dimen/twenty"
                            android:orientation="vertical"
                            android:padding="@dimen/five"
                            android:src="@drawable/logo">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.rilixtech.widget.countrycodepicker.CountryCodePicker
                                    android:id="@+id/addon_countrycode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/edittext_height"
                                    android:layout_marginTop="@dimen/seven"
                                    android:gravity="center_vertical"
                                    app:ccp_countryPreference="IN"
                                    app:ccp_hideNameCode="true"
                                    app:ccp_hidePhoneCode="false"
                                    app:ccp_setCountryByTimeZone="true"
                                    app:ccp_textColor="@color/black"
                                    app:ccp_textSize="@dimen/ts_fifteen" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/et_mobile"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/edittext_height"
                                        android:layout_marginTop="@dimen/seven"
                                        android:background="@drawable/back_edittext_noborder_light"
                                        android:inputType="phone"
                                        android:textColorHint="@color/black"
                                        android:textSize="@dimen/ts_thirtyfive" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/theme_bluegradient_one" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_sendotp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/fifty"
                            android:background="@drawable/btn_rect_primary"
                            android:padding="@dimen/ten"
                            android:text="Send OTP"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llay_passwordscreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/thirty"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/imageView"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="@+id/imageView"
                        app:layout_constraintTop_toBottomOf="@+id/imageView">

                        <RelativeLayout
                            android:id="@+id/card_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/fifteen"
                            android:layout_marginRight="@dimen/fifteen"
                            android:visibility="visible">

                            <LinearLayout
                                android:id="@+id/laypwd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/ten"
                                android:orientation="vertical"
                                android:padding="@dimen/five"
                                android:src="@drawable/logo">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Enter otp send to your mobile"
                                    android:textSize="@dimen/ts_twentyfive" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <EditText
                                            android:id="@+id/ed_otp"
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/edittext_height"
                                            android:layout_marginTop="@dimen/seven"
                                            android:background="@drawable/back_edittext_noborder_light"
                                            android:inputType="number"
                                            android:maxLength="4"
                                            android:textSize="@dimen/ts_thirtyfive" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="@color/theme_bluegradient_one" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Enter new password"
                                    android:textSize="@dimen/ts_twentyfive" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <EditText
                                            android:id="@+id/ed_password"
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/edittext_height"
                                            android:layout_marginTop="@dimen/seven"
                                            android:background="@drawable/back_edittext_noborder_light"
                                            android:inputType="textPassword"
                                            android:textSize="@dimen/ts_thirtyfive" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="@color/theme_bluegradient_one" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/register_reenterpassword"
                                    android:textSize="@dimen/ts_twentyfive" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <EditText
                                            android:id="@+id/ed_repassword"
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/edittext_height"
                                            android:layout_marginTop="@dimen/seven"
                                            android:background="@drawable/back_edittext_noborder_light"
                                            android:inputType="textPassword"
                                            android:textSize="@dimen/ts_thirtyfive" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="@color/theme_bluegradient_one" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/goback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/twenty"
                            android:text="Edit Number"
                            android:textSize="@dimen/ts_seventeen" />

                        <Button
                            android:id="@+id/btn_submitpwd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/twenty"
                            android:background="@drawable/plus"
                            android:padding="@dimen/ten"
                            android:text="Change Password"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </RelativeLayout>

        <include
            layout="@layout/include_connection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/twenty" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>