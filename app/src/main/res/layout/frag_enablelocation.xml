<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/headlayout"
    android:background="@color/appbackcolor">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/thirty"
        android:layout_marginRight="@dimen/thirty">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/enable_location_txt">

            <ImageView
                android:layout_width="@dimen/twohundred"
                android:layout_height="@dimen/twohundred"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/thirty"
                android:src="@drawable/map" />
        </RelativeLayout>

        <TextView
            android:id="@+id/enable_location_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="Enable Location"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="@dimen/ts_thirtyfive" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/enable_location_txt"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:paddingTop="@dimen/ten"
                android:text="You need to enable location to use this application"
                android:textColor="@color/fontcolordark"
                android:textSize="@dimen/ts_fifteen" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/enable_location_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fifty"
                    android:background="@drawable/rounded_corner_button"                    android:text="Enable Location"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rlprogress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparentblack"

        android:visibility="gone">

        <com.mikhaellopez.circularimageview.CircularImageView
            android:layout_width="@dimen/hundred"
            android:layout_height="@dimen/hundred"
            android:layout_centerInParent="true"
            android:src="@color/white"
            app:civ_shadow="true"
            app:civ_shadow_radius="1dp"
            app:civ_border_width="2dp"/>

        <ProgressBar
            android:layout_width="@dimen/onetwenty"
            android:layout_height="@dimen/onetwenty"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:id="@+id/lllogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="@dimen/fifty"
                android:layout_height="@dimen/fifty"
                android:elevation="@dimen/ten"
                android:src="@drawable/logo" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
