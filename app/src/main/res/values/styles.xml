<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
        <item name="searchViewStyle">@android:style/Widget.Material.SearchView</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:navigationBarColor">@color/backgroundEditActivity</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlHighlight">@color/ripple_material_dark</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/mainactivity1</item>
    </style>

    <style name="Button.Primary.Borderless" parent="@style/Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="mySpinnerItemStyle" parent="@android:style/Widget.Holo.DropDownItem.Spinner">
        <item name="android:textSize">@dimen/ts_fifteen</item>
        <item name="android:textColor">@color/c_gray2</item>
        <item name="color">@color/c_gray2</item>
    </style>

    <style name="TransparentProgressDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="DialogStyle" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:fontFamily">@font/customfont</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="LightTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="fontcoloreditext">@color/fontcoloreditext</item>
        <item name="fontcolortextview">@color/fontcolortextview</item>
        <item name="fontcoloractionbar">@color/fontcoloractionbar</item>
        <item name="fontcolorspinner">@color/fontcolorspinner</item>
        <item name="fontcolorbutton">@color/fontcolorbutton</item>
        <item name="coloractionbar">@color/coloractionbar</item>
    </style>

    <style name="DarkTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dark_colorPrimary</item>
        <item name="colorPrimaryDark">@color/dark_colorPrimaryDark</item>
        <item name="colorAccent">@color/dark_colorAccent</item>
        <item name="fontcoloreditext">@color/dark_fontcoloreditext</item>
        <item name="fontcolortextview">@color/dark_fontcolortextview</item>
        <item name="fontcoloractionbar">@color/dark_fontcoloractionbar</item>
        <item name="fontcolorspinner">@color/dark_fontcolorspinner</item>
        <item name="fontcolorbutton">@color/dark_fontcolorbutton</item>
        <item name="coloractionbar">@color/dark_coloractionbar</item>
    </style>

    <style name="CutShapeTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="shapeAppearanceMediumComponent">@style/CutShapeAppearance</item>
    </style>

    <style name="CutShapeAppearance" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="RoundShapeAppearance" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="RoundShapeTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="shapeAppearanceMediumComponent">@style/RoundShapeAppearance</item>
    </style>

    <style name="buttonstyle" parent="TextAppearance.AppCompat.Button">
        <item name="android:padding">@dimen/five</item>
        <item name="android:paddingLeft">@dimen/fifteen</item>
        <item name="android:paddingRight">@dimen/fifteen</item>
        <item name="android:background">@drawable/btn_rect_primary</item>
    </style>


<!--    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">-->
<!--        <item name="android:navigationBarColor">@color/backgroundEditActivity</item>-->
<!--        <item name="colorAccent">@color/colorAccent</item>-->
<!--        <item name="colorControlHighlight">@color/ripple_material_dark</item>-->
<!--        <item name="colorPrimary">@color/colorPrimary</item>-->
<!--        <item name="colorPrimaryDark">@color/mainactivity1</item>-->
<!--    </style>-->


    <style name="ActionButton">
        <item name="android:gravity">center</item>
        <item name="android:background">?actionBarItemBackground</item>
        <item name="android:scaleType">center</item>
        <item name="android:minWidth">@dimen/action_button_min_width_material</item>
        <item name="android:minHeight">@dimen/action_button_min_height_material</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">12.0dip</item>
        <item name="android:paddingEnd">12.0dip</item>
    </style>

    <style name="EditText">
        <item name="android:textColorPrimary">#ffffffff</item>
        <item name="android:textSize">14.0sp</item>
        <item name="android:singleLine">true</item>
        <item name="colorControlActivated">#ffffffff</item>
        <item name="colorControlNormal">#ffffffff</item>
    </style>

    <style name="PickerEditText">
        <item name="android:textSize">22.0sp</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4.0dip</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>

    <style name="SelectableItemBackground">
        <item name="android:theme">@style/SelectableItemTheme</item>
        <item name="android:background">?selectableItemBackground</item>
    </style>

    <style name="SelectableItemTheme">
        <item name="colorControlHighlight">@color/ripple_material_light</item>
    </style>

    <style name="TextBelowImage" parent="@android:style/Widget.TextView">
        <item name="android:textSize">11.0sp</item>
        <item name="android:textColor">@color/text_selector</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

</resources>
